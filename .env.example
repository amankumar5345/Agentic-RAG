# Copy to .env and fill in. .env is gitignored.

# Groq API key: orchestrator (gpt-oss-120b) and intent router (gpt-oss-20b).
GROQ_API_KEY=

# DeepSeek API key: DeepEval judge, and the default LithoBench drafting model.
DEEPSEEK_API_KEY=

# Optional mode override: demo or live. Leave blank to infer the mode from
# whether the API keys above are present.
LITHO_MODE=

# Directory the geometry bridge writes unreal_mailbox.json into, and the
# Unreal rendering blueprint polls. Relative paths resolve from the cwd.
LITHO_MAILBOX_DIR=./runtime/unreal_mailbox

# WAV file written by the Unreal mic manager and polled by the app.
# Default is a single .wav suffix; if your Blueprint writes .wav.wav,
# set this to ./runtime/UserAudioInput.wav.wav.
LITHO_AUDIO_PATH=./runtime/UserAudioInput.wav

# Largest allowed drawing size; enforced by src/core/geometry.py.
LITHO_MAX_SIZE=5000

# Suggested timeout for src/services/ue_ack.py wait_for_ack(); passed by the caller.
LITHO_ACK_TIMEOUT_S=5
