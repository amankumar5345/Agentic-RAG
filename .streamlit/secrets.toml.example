# Copy to .streamlit/secrets.toml for Streamlit Community Cloud, or export the
# same names as environment variables. Never commit real values.

GROQ_API_KEY = "your_groq_key"
DEEPSEEK_API_KEY = "your_deepseek_key"

# Optional
LITHO_MODE = "demo"
LITHO_RATE_LIMIT = "20"
LITHO_LOG = "0"
LITHO_MAILBOX_DIR = "./runtime/unreal_mailbox"
LITHO_AUDIO_PATH = "./runtime/UserAudioInput.wav"
